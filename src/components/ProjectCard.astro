---
interface Props {
  name: string;
  tag: string;
  shipped: string;
  description: string;
  url?: string | null;
  mrr: number;
  logo?: string | null;
  status?: string;
  ended?: string | null;
}

const { name, tag, shipped, description, url, mrr, logo, status = 'active', ended } = Astro.props;
const isSunset = status === 'sunset';
const href = !isSunset && url ? url : undefined;
const Tag = href ? 'a' : 'div';
const initials = name.split(' ').map(word => word.charAt(0)).join('');
---

<Tag
  class:list={["project-card", { "is-sunset": isSunset }]}
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener noreferrer" : undefined}
>
  <div class="project-header">
    <div class="project-info">
      <h3 class="project-name">{name}{href && <span class="project-arrow" aria-hidden="true">↗</span>}</h3>
      <div class="project-tag">{tag}</div>
    </div>
    <div class:list={["project-logo", { "has-logo": logo }]}>
      {logo ? (
        <img src={logo} alt={`${name} logo`} class="logo-image" width="48" height="48" loading="lazy" />
      ) : (
        <span class="logo-letter">{initials}</span>
      )}
    </div>
  </div>
  <div class="project-bottom">
    <div class="project-desc">{description}</div>
    <div class="project-meta">
      {/* <div class="project-mrr">€{mrr}/mo</div> */}
      <div class="project-shipped">{shipped}</div>
      {isSunset ? (
        <div class="project-status status-sunset">Sunset{ended ? ` — ${ended}` : ''}</div>
      ) : (
        <div class="project-status status-active"><span class="status-dot" aria-hidden="true"></span>Active</div>
      )}
    </div>
  </div>
</Tag>

<style>
  .project-card {
    background: var(--bg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
    position: relative;
    transition: background 0.4s ease;
    text-decoration: none;
    color: inherit;
  }

  a.project-card {
    cursor: pointer;
  }

  a.project-card:hover {
    background: var(--surface);
  }

  a.project-card:focus-visible {
    background: var(--surface);
    outline-offset: -6px;
  }

  .project-card.is-sunset {
    background-image: var(--hatch);
    background-size: 8px 8px;
  }

  .project-card.is-sunset .project-name {
    color: var(--muted);
  }

  .project-card.is-sunset .project-logo {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .project-info {
    flex: 1;
  }

  .project-logo {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .project-logo.has-logo {
    background: none;
    border: none;
  }

  .logo-letter {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--muted);
  }

  .logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .project-name {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .project-arrow {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.4em;
    vertical-align: super;
    margin-left: 0.5em;
    color: var(--muted);
    opacity: 0;
    translate: -4px 4px;
    transition: opacity 0.35s ease, translate 0.35s ease;
  }

  a.project-card:hover .project-arrow,
  a.project-card:focus-visible .project-arrow {
    opacity: 1;
    translate: 0 0;
  }

  .project-tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .project-shipped {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--muted);
    opacity: 0.7;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.45em 0.9em;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }

  .status-sunset {
    color: var(--muted);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fg);
    animation: statusPulse 2.4s ease-in-out infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  .project-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 2rem;
  }

  .project-desc {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.7;
    max-width: 300px;
  }

  .project-mrr {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--muted);
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .project-card {
      min-height: 260px;
    }
  }
</style>
